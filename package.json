{
  "name": "mel-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev:web\" \"npm run dev:sanity\"",
    "dev:web": "./dev-web.sh",
    "dev:sanity": "./dev-sanity.sh",
    "install:all": "npm install && cd web && npm install && cd ../sanity && npm install",
    "deploy:web": "./deploy-web.sh",
    "deploy:studio": "./deploy-sanity.sh",
    "deploy": "npm run deploy:web && npm run deploy:studio"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.0.0"
  }
}
