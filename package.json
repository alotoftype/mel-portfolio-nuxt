{
  "name": "mel-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:sanity\"",
    "dev:web": "cd web && npm run dev",
    "dev:sanity": "cd sanity && npm run dev",
    "install:all": "npm install && cd web && npm install && cd ../sanity && npm install"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^8.2.2",
    "tailwindcss": "^4.0.0"
  }
}
