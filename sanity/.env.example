SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production
# Optional explicit override for all environments:
# SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
#
# Automatic defaults used when SANITY_STUDIO_PREVIEW_URL is not set:
# - local `sanity dev`: SANITY_STUDIO_LOCAL_PREVIEW_URL (default: http://localhost:3000)
# - deployed Studio: SANITY_STUDIO_PRODUCTION_PREVIEW_URL (default: https://melshotya.com)
SANITY_STUDIO_LOCAL_PREVIEW_URL=http://localhost:3000
SANITY_STUDIO_PRODUCTION_PREVIEW_URL=https://melshotya.com
SANITY_STUDIO_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://melshotya.com
# Token with write access (for migration script only)
SANITY_API_TOKEN=your-write-token
