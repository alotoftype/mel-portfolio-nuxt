# Sanity CMS
# Get these from https://www.sanity.io/manage
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_TOKEN=your-read-token
SANITY_STUDIO_URL=http://localhost:3333
SANITY_FORCE_FALLBACK=false
SANITY_FETCH_TIMEOUT_MS=1200

# Site/runtime caching
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_ISR_SECONDS=60

# Dev performance switches
# Use `none` (default in dev) for fastest local image rendering
NUXT_IMAGE_PROVIDER=none
# Keep false unless running in Docker/VM where file watching needs polling
CHOKIDAR_USEPOLLING=false

# Contact email delivery (server-side /api/contact)
# https://resend.com/api-keys
RESEND_API_KEY=
# Where new contact submissions are delivered
CONTACT_NOTIFICATION_EMAIL=melshotya@gmail.com
# Must be a verified sender in Resend (or onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Optional reply-to for user auto-response
CONTACT_REPLY_TO_EMAIL=melshotya@gmail.com
